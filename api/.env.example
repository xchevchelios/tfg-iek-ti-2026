# Copiar a .env y completar. NUNCA versionar el .env real.

# Ruta del archivo SQLite
DB_PATH=/home/xxv4th0xx/tfg-sistema/api/sensores.db

# Broker MQTT local (lo usa el servicio de ingesta)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=estaciones/+/data
MQTT_USER=tfg_nodo
MQTT_PASS=cambiar_esta_clave

# Origenes permitidos para CORS, separados por coma.
# Prefijar con 're:' para usar una expresion regular (URLs de preview de Cloudflare).
CORS_ORIGINS=https://tfg-iek-ti-2026.alvaro-aguinagalde13.workers.dev,re:^https://[a-z0-9-]+-tfg-iek-ti-2026\.alvaro-aguinagalde13\.workers\.dev$

# Token para las operaciones de escritura de la pagina de gestion.
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Si queda vacio, las escrituras se rechazan con 503.
API_TOKEN=
