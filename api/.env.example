# Copiar a .env y completar. NUNCA versionar el .env real.

# Ruta del archivo SQLite
DB_PATH=/home/xxv4th0xx/tfg-sistema/api/sensores.db

# Broker MQTT local (lo usa el servicio de ingesta)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=estaciones/+/data
MQTT_USER=tfg_nodo
MQTT_PASS=cambiar_esta_clave

# Usuario MQTT de solo lectura del panel (estaciones/# y gateway/#). La API se
# lo entrega al navegador solo con sesion iniciada.
MQTT_PANEL_USER=web_panel
MQTT_PANEL_PASS=cambiar_esta_clave

# Desfase del huso local respecto de UTC, en horas. Paraguay: -3.
# Se usa para traducir las fechas del calendario del navegador a los timestamps
# UTC que publica el gateway.
TZ_OFFSET_HORAS=-3

# Origenes permitidos para CORS, separados por coma.
# Prefijar con 're:' para usar una expresion regular.
CORS_ORIGINS=https://aire-campus-una.org,https://www.aire-campus-una.org

# --- Autenticacion con Google (OpenID Connect) ---
# Se obtienen creando un "OAuth 2.0 Client ID" de tipo "Web application" en
# https://console.cloud.google.com/apis/credentials
# En "Authorized redirect URIs" hay que cargar EXACTAMENTE el valor de
# OAUTH_REDIRECT_URI: Google compara la cadena completa, sin tolerancia.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://api.aire-campus-una.org/api/auth/callback

# A donde vuelve el navegador despues del login.
FRONTEND_URL=https://aire-campus-una.org

# Duracion de la sesion en horas, con renovacion mientras se use.
SESION_HORAS=12

# El navegador no guarda una cookie Secure sobre http://localhost.
# En produccion: true. Solo en desarrollo local: false.
COOKIE_SECURE=true
