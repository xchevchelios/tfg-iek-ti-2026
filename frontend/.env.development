# Desarrollo: las peticiones salen por el proxy de Vite (mismo origen).
VITE_API_BASE_URL=
VITE_MQTT_URL=ws://localhost:5173/mqtt

# Backend real al que apunta el proxy de desarrollo (lo lee vite.config.js).
VITE_DEV_BACKEND=https://air-quality-campus-una.duckdns.org

# Credenciales del usuario MQTT de solo lectura.
# NO son un secreto: cualquier cliente MQTT de navegador las expone en el
# bundle. La proteccion real es el ACL de Mosquitto, que limita a este usuario
# a suscribirse a 'estaciones/#' sin poder publicar.
VITE_MQTT_USER=web_publico
VITE_MQTT_PASS=web2026

# Vista inicial del mapa (campus UNA - San Lorenzo).
VITE_MAPA_CENTRO=-25.3345,-57.5150
VITE_MAPA_ZOOM=16
