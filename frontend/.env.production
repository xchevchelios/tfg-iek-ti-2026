# Produccion: el frontend se sirve desde Cloudflare y la API vive en la VM.
# Ambos bajo el mismo dominio registrable (aire-campus-una.org), de modo que
# son same-site: condicion necesaria para que una cookie de sesion de la API
# no sea tratada como cookie de terceros por el navegador.
# Siguen siendo origenes distintos, asi que CORS continua aplicando.
VITE_API_BASE_URL=https://api.aire-campus-una.org
VITE_MQTT_URL=wss://api.aire-campus-una.org/mqtt

# Ver la nota sobre estas credenciales en .env.development.
VITE_MQTT_USER=web_publico
VITE_MQTT_PASS=web2026

VITE_MAPA_CENTRO=-25.3345,-57.5150
VITE_MAPA_ZOOM=16
